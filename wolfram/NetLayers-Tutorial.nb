         ThreadingLayer[<|"Type" -> "Threading", "Arrays" -> <||>, 
           "Parameters" -> <|"Function" -> NeuralNetworks`ValidatedParameter[
               Times], "Broadcasting" -> NeuralNetworks`ValidatedParameter[
               Automatic]|>, "Inputs" -> <|"Input1" -> NeuralNetworks`TensorT[
               {3}, NeuralNetworks`RealT], "Input2" -> NeuralNetworks`TensorT[
               {3}, NeuralNetworks`AtomT]|>, "Outputs" -> 
            <|"Output" -> NeuralNetworks`TensorT[{3}, 
               NeuralNetworks`AtomT]|>|>, <|"Version" -> "15.0.2", 
           "Unstable" -> False|>], Selectable -> False, Editable -> False, 
         SelectWithContents -> True]}], "}"}]], "Output", 
   CellLabel -> "Out[28]="], Cell["12. NetTrain: learning a spring", 
   "Section"], Cell[TextData[{"Now the bond branch learns a force from \
examples. The examples are chains of four beads joined by harmonic springs, U \
= (k/2)(r - ", Cell[BoxData[SuperscriptBox["1)", "2"]]], " with k = 50, so \
the exact pair force is f(r) = -50 (r - 1). The bond lengths are drawn around \
1 and the forces on the beads are computed exactly. NetTrain gets only the \
bead forces, never f(r) itself; it has to work out the pair force behind \
them. This is force matching, as in PolymerNN."}], "Text"], 
  Cell["kSpring = 50.;\nrandomChain[] := \
Accumulate[Prepend[Table[RandomReal[NormalDistribution[1., 0.12]] \
Normalize[RandomVariate[NormalDistribution[], 3]], {3}], {0., 0., \
0.}]];\nspringForces[x_] := Module[{r, u}, {r, u} = edgeGeometry[x, bonds]; \
Ab.((-kSpring (r - 1.)) u)];\nmu8 = N@Subdivide[0.6, 1.4, 7]; gw8 = \
1/(mu8[[2]] - mu8[[1]])^2;\nrbf8[r_] := Exp[-gw8 Outer[Subtract, r, \
mu8]^2];\nSeedRandom[4]; chains = Table[randomChain[], {3000}];\ndata = \
<|\"bf\" -> (rbf8[First[edgeGeometry[#, bonds]]] & /@ chains), \"bu\" -> \
(Last[edgeGeometry[#, bonds]] & /@ chains),\n   \"F\" -> (springForces /@ \
chains)|>;\nDimensions /@ data", "Input", CellLabel -> "In[29]:="], 
  Cell[BoxData[RowBox[{"\[LeftAssociation]", 
      RowBox[{RowBox[{"\"bf\"", "\[Rule]", RowBox[
           {"{", RowBox[{"3000", ",", "3", ",", "8"}], "}"}]}], ",", 
        RowBox[{"\"bu\"", "\[Rule]", RowBox[{"{", RowBox[{"3000", ",", "3", 
              ",", "3"}], "}"}]}], ",", RowBox[{"\"F\"", "\[Rule]", 
          RowBox[{"{", RowBox[{"3000", ",", "4", ",", "3"}], "}"}]}]}], 
      "\[RightAssociation]"}]], "Output", CellLabel -> "Out[29]="], 
  Cell["The network to train: the bond branch again, now with 8 basis \
functions and phi = 8 \[RightArrow] 16 \[RightArrow] tanh \[RightArrow] 1, \
starting from random weights.", "Text"], Cell["springNet = NetGraph[<|\n   \
\"phiB\" -> NetMapOperator[NetChain[{LinearLayer[16], ElementwiseLayer[Tanh], \
LinearLayer[{}]}]],\n   \"repB\" -> ReplicateLayer[3, 2], \"mB\" -> \
ThreadingLayer[Times],\n   \"Ab\" -> NetArrayLayer[\"Array\" -> Ab, \
LearningRateMultipliers -> 0], \"sumB\" -> DotLayer[]|>,\n  {NetPort[\"bf\"] \
-> \"phiB\" -> \"repB\", {\"repB\", NetPort[\"bu\"]} -> \"mB\", {\"Ab\", \
\"mB\"} -> \"sumB\" -> NetPort[\"F\"]},\n  \"bf\" -> {3, 8}, \"bu\" -> {3, \
3}];\nSeedRandom[5];\nres = NetTrain[springNet, data, All, ValidationSet -> \
Scaled[0.1], BatchSize -> 64, LearningRate -> 0.01,\n   MaxTrainingRounds -> \
400, TimeGoal -> 30, TrainingProgressReporting -> None];\ntrained = \
res[\"TrainedNet\"];\n{\"rounds\" -> res[\"TotalRounds\"], \"RMS force \
error\" -> Sqrt[res[\"FinalValidationLoss\"]],\n \"RMS force\" -> \
Sqrt[Mean[Flatten[data[\"F\"]^2]]]}", "Input", CellLabel -> "In[30]:="], 
  Cell[BoxData[RowBox[{"{", RowBox[{RowBox[{"\"rounds\"", "\[Rule]", "400"}], 
        ",", RowBox[{"\"RMS force error\"", "\[Rule]", 
          "0.0026224738970921408`"}], ",", RowBox[{"\"RMS force\"", 
          "\[Rule]", "4.284719511475703`"}]}], "}"}]], "Output", 
   CellLabel -> "Out[30]="], Cell["The trained phi is a function of one \
variable, so it can be drawn and compared with the exact spring force -50 (r \
- 1). The shaded band is the range of bond lengths in the data; outside it \
the network has no information.", "Text"], Cell["phiLearned = \
NetExtract[trained, {\"phiB\", \"Net\"}];\nrr = Subdivide[0.6, 1.4, 200]; \
rTrain = Flatten[First[edgeGeometry[#, bonds]] & /@ \
chains];\nShow[Plot[-kSpring (r - 1), {r, 0.6, 1.4}, PlotStyle -> {Dashed, \
Black}],\n ListLinePlot[Transpose[{rr, phiLearned[rbf8[rr]]}], PlotStyle -> \
{Thick, RGBColor[\"#E07B00\"]}],\n Graphics[{Opacity[0.12], Blue, \
Rectangle[{Quantile[rTrain, 0.005], -25}, {Quantile[rTrain, 0.995], 25}]}],\n \
PlotRange -> {-25, 25}, Frame -> True, FrameLabel -> {\"r\", \"pair force \
f(r)\"},\n PlotLabel -> \"learned (orange) vs exact spring (dashed)\", \
ImageSize -> 500]", "Input", CellLabel -> "In[31]:="], 
