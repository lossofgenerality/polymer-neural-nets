                "0.7721020579338074`"}]}, {RowBox[{"-", 
                "0.7672325372695923`"}], RowBox[{"-", 
                "0.7672325372695923`"}], RowBox[{"-", 
                "0.7672325372695923`"}]}, {RowBox[{"-", 
