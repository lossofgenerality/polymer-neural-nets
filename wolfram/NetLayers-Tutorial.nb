Notebook[{Cell["The Layers Behind a Graph Force Network", "Title"], 
  Cell["Every Wolfram Language layer used in PolymerNN, explained on a \
four-bead polymer", "Subtitle"], Cell["\[Copyright] 2026 Computational \
Classnotes \[CenterDot] CC BY-NC-SA 4.0\nAuthors: Dara O Shayda \[CenterDot] \
Noor Hoshino", "Text"], Cell["The force network in PolymerNN.wl is built from \
a handful of standard layers: LinearLayer, ElementwiseLayer, NetChain, \
NetMapOperator, ThreadingLayer, ReplicateLayer, NetArrayLayer and DotLayer. \
They are joined in a NetGraph through NetPorts and trained with NetTrain. \
This notebook takes them one at a time. Each one is applied to a tiny chain \
of four beads, small enough that every number can be checked by hand, and \
each layer is compared with the same computation written in ordinary Wolfram \
Language.", "Text"], Cell["By the end, the pieces are assembled into a \
working mini force network, which is trained to learn a spring force from \
examples. It is the polymer network in miniature. This notebook does not need \
PolymerNN.wl.", "Text"], Cell["Grid[Prepend[{\n   {\"LinearLayer\", \"W.x + \
b\", \"the three linear maps inside phiB and phiN\"},\n   \
{\"ElementwiseLayer[Tanh]\", \"tanh of each entry\", \"the nonlinearity \
inside phiB and phiN\"},\n   {\"NetChain\", \"layers one after another\", \
\"phiB and phiN themselves\"},\n   {\"NetMapOperator\", \"the same net on \
every row\", \"applies phi to every edge\"},\n   {\"ThreadingLayer[Times]\", \
\"entrywise product\", \"cut (phi times cutoff), mB and mN (f times u)\"},\n  \
 {\"ThreadingLayer[Plus]\", \"entrywise sum\", \"total (bond + non-bonded \
forces)\"},\n   {\"ReplicateLayer[3, 2]\", \"copy each number 3 times\", \
\"repB and repN\"},\n   {\"NetArrayLayer\", \"a stored array, optionally \
frozen\", \"Ab and An, the incidence matrices\"},\n   {\"DotLayer\", \"matrix \
product\", \"sumB and sumN (A.m)\"},\n   {\"NetGraph, NetPort\", \"wiring \
with named inputs and outputs\", \"the whole force network\"}},\n  Style[#, \
Bold] & /@ {\"layer\", \"what it computes\", \"where PolymerNN uses it\"}], \
Frame -> All, Alignment -> Left, Background -> {None, {LightBlue}}]", 
   "Input", CellLabel -> "In[1]:="], 
  Cell[BoxData[TagBox[GridBox[{{StyleBox["\"layer\"", Bold, 
         StripOnInput -> False], StyleBox["\"what it computes\"", Bold, 
         StripOnInput -> False], StyleBox["\"where PolymerNN uses it\"", 
         Bold, StripOnInput -> False]}, {"\"LinearLayer\"", "\"W.x + b\"", 
        "\"the three linear maps inside phiB and phiN\""}, 
       {"\"ElementwiseLayer[Tanh]\"", "\"tanh of each entry\"", 
        "\"the nonlinearity inside phiB and phiN\""}, 
       {"\"NetChain\"", "\"layers one after another\"", 
        "\"phiB and phiN themselves\""}, {"\"NetMapOperator\"", 
        "\"the same net on every row\"", "\"applies phi to every edge\""}, 
       {"\"ThreadingLayer[Times]\"", "\"entrywise product\"", 
        "\"cut (phi times cutoff), mB and mN (f times u)\""}, 
       {"\"ThreadingLayer[Plus]\"", "\"entrywise sum\"", 
        "\"total (bond + non-bonded forces)\""}, {"\"ReplicateLayer[3, 2]\"", 
        "\"copy each number 3 times\"", "\"repB and repN\""}, 
       {"\"NetArrayLayer\"", "\"a stored array, optionally frozen\"", 
        "\"Ab and An, the incidence matrices\""}, {"\"DotLayer\"", 
        "\"matrix product\"", "\"sumB and sumN (A.m)\""}, 
       {"\"NetGraph, NetPort\"", "\"wiring with named inputs and outputs\"", 
        "\"the whole force network\""}}, GridBoxAlignment -> 
       {"Columns" -> {{Left}}}, AutoDelete -> False, 
      GridBoxBackground -> {"Columns" -> {{None}}, 
        "Rows" -> {RGBColor[0.87, 0.94, 1]}}, GridBoxFrame -> 
       {"Columns" -> {{True}}, "Rows" -> {{True}}}, GridBoxItemSize -> 
       {"Columns" -> {{Automatic}}, "Rows" -> {{Automatic}}}], "Grid"]], 
   "Output", CellLabel -> "Out[1]="], 
  Cell["1. The example: a chain of four beads", "Section"], 
  Cell[TextData[{"Four beads, three bonds (1-2, 2-3, 3-4) and three \
non-bonded pairs (1-3, 1-4, 2-4). These are the edges of the graph. For each \
edge we need its length r and its unit vector u = (", 
     Cell[BoxData[SubscriptBox["x", "i"]]], " - ", 
     Cell[BoxData[SubscriptBox["x", "j"]]], ")/r."}], "Text"], 
  Cell["x4 = {{0., 0., 0.}, {1., 0., 0.}, {0.55, 0.88, 0.}, {-0.25, 1.3, \
0.5}};\nbonds = {{1, 2}, {2, 3}, {3, 4}};\npairs = {{1, 3}, {1, 4}, {2, \
4}};\nedgeGeometry[x_, pr_] := Module[{d = x[[pr[[All, 1]]]] - x[[pr[[All, \
2]]]], r},\n   r = Sqrt[Total[d^2, {2}]]; {r, d/r}];\n{rB, uB} = \
edgeGeometry[x4, bonds];\n{rN, uN} = edgeGeometry[x4, \
pairs];\nGrid[Prepend[Join[Transpose[{bonds, rB, uB}], Transpose[{pairs, rN, \
uN}]], {\"edge\", \"r\", \"u\"}], Frame -> All]", "Input", 
   CellLabel -> "In[2]:="], 
  Cell[BoxData[TagBox[GridBox[{{"\"edge\"", "\"r\"", "\"u\""}, 
       {RowBox[{"{", RowBox[{"1", ",", "2"}], "}"}], "1.`", 
        RowBox[{"{", RowBox[{RowBox[{"-", "1.`"}], ",", "0.`", ",", "0.`"}], 
          "}"}]}, {RowBox[{"{", RowBox[{"2", ",", "3"}], "}"}], 
        "0.9883825170448939`", RowBox[{"{", RowBox[{"0.4552893158667235`", 
            ",", RowBox[{"-", "0.8903435510282594`"}], ",", "0.`"}], "}"}]}, 
       {RowBox[{"{", RowBox[{"3", ",", "4"}], "}"}], "1.032666451474047`", 
        RowBox[{"{", RowBox[{"0.7746935119835311`", ",", 
            RowBox[{"-", "0.4067140937913538`"}], ",", 
            RowBox[{"-", "0.4841834449897069`"}]}], "}"}]}, 
       {RowBox[{"{", RowBox[{"1", ",", "3"}], "}"}], "1.0377379245262264`", 
        RowBox[{"{", RowBox[{RowBox[{"-", "0.52999894000318`"}], ",", 
            RowBox[{"-", "0.847998304005088`"}], ",", "0.`"}], "}"}]}, 
       {RowBox[{"{", RowBox[{"1", ",", "4"}], "}"}], "1.4150971698084907`", 
        RowBox[{"{", RowBox[{"0.1766663133343933`", ",", 
            RowBox[{"-", "0.9186648293388452`"}], ",", 
            RowBox[{"-", "0.3533326266687866`"}]}], "}"}]}, 
       {RowBox[{"{", RowBox[{"2", ",", "4"}], "}"}], "1.8714967272212901`", 
        RowBox[{"{", RowBox[{"0.6679146064315811`", ",", 
            RowBox[{"-", "0.6946311906888444`"}], ",", 
            RowBox[{"-", "0.26716584257263243`"}]}], "}"}]}}, 
      AutoDelete -> False, GridBoxFrame -> {"Columns" -> {{True}}, 
        "Rows" -> {{True}}}, GridBoxItemSize -> {"Columns" -> {{Automatic}}, 
        "Rows" -> {{Automatic}}}], "Grid"]], "Output", 
   CellLabel -> "Out[2]="], Cell["Graphics3D[{{Gray, Tube[x4, 0.04]}, \
{Orange, Dashed, Line[x4[[#]]] & /@ pairs},\n  {RGBColor[0.2, 0.4, 0.8], \
Sphere[x4, 0.12]}, MapIndexed[Text[Style[First[#2], Bold, 16], #1 + {0, 0, \
0.25}] &, x4]},\n Boxed -> False, PlotLabel -> \"bonds (grey) and non-bonded \
pairs (orange)\"]", "Input", CellLabel -> "In[3]:="], 
  Cell[BoxData[Graphics3DBox[{{GrayLevel[0.5], 
       TubeBox[{{0., 0., 0.}, {1., 0., 0.}, {0.55, 0.88, 0.}, 
         {-0.25, 1.3, 0.5}}, 0.04]}, {RGBColor[1, 0.5, 0], 
       Dashing[{Small, Small}], {Line3DBox[{{0., 0., 0.}, {0.55, 0.88, 0.}}], 
        Line3DBox[{{0., 0., 0.}, {-0.25, 1.3, 0.5}}], 
        Line3DBox[{{1., 0., 0.}, {-0.25, 1.3, 0.5}}]}}, 
      {RGBColor[0.2, 0.4, 0.8], SphereBox[{{0., 0., 0.}, {1., 0., 0.}, 
         {0.55, 0.88, 0.}, {-0.25, 1.3, 0.5}}, 0.12]}, 
      {Text3DBox[FormBox[StyleBox["1", Bold, 16, StripOnInput -> False], 
         TraditionalForm], {0., 0., 0.25}], Text3DBox[
        FormBox[StyleBox["2", Bold, 16, StripOnInput -> False], 
         TraditionalForm], {1., 0., 0.25}], Text3DBox[
        FormBox[StyleBox["3", Bold, 16, StripOnInput -> False], 
         TraditionalForm], {0.55, 0.88, 0.25}], 
       Text3DBox[FormBox[StyleBox["4", Bold, 16, StripOnInput -> False], 
         TraditionalForm], {-0.25, 1.3, 0.75}]}}, Boxed -> False, 
     PlotLabel -> FormBox["\"bonds (grey) and non-bonded pairs (orange)\"", 
       TraditionalForm]]], "Output", CellLabel -> "Out[3]="], 
  Cell[TextData[{"The networks never see r directly. They see a radial basis, \
the vector of Gaussians ", Cell[BoxData[SubscriptBox["\[Rho]", "k"]]], 
     "(r) = exp(-\[Gamma] (r - ", Cell[BoxData[SubscriptBox["\[Mu]", "k"]]], 
     Cell[BoxData[SuperscriptBox[")", "2"]]], 
     "). Here there are four centres ", 
     Cell[BoxData[SubscriptBox["\[Mu]", "k"]]], ", so each edge becomes a \
4-vector, and the 3 bonds give a 3\[Times]4 matrix. PolymerNN uses 16 \
centres. The smooth cutoff c(r) is 1 at r = 0 and falls to 0 at ", 
     Cell[BoxData[SubscriptBox["r", "c"]]], ". Here ", 
     Cell[BoxData[SubscriptBox["r", "c"]]], 
     " = 2, so all three pairs feel it (PolymerNN uses ", 
     Cell[BoxData[SubscriptBox["r", "c"]]], " = 1.5)."}], "Text"], 
  Cell["mu = {0.8, 1.0, 1.2, 1.4}; gw = 25.;\nrbf[r_] := Exp[-gw \
Outer[Subtract, r, mu]^2];\ncutoff[r_] := UnitStep[2. - r] 0.5 (Cos[Pi r/2.] \
+ 1);\nbfeat = rbf[rB]; nfeat = rbf[rN]; nc = \
cutoff[rN];\n{MatrixForm[bfeat], MatrixForm[nfeat], nc}", "Input", 
   CellLabel -> "In[4]:="], 
  Cell[BoxData[RowBox[
     {"{", RowBox[{TagBox[RowBox[{"(", "\[NoBreak]", 
           GridBox[{{"0.3678794411714425`", "1.`", "0.3678794411714425`", 
              "0.018315638888734213`"}, {"0.41180748090260516`", 
              "0.9966315382842558`", "0.32642698740603654`", 
              "0.014469333403889366`"}, {"0.25837534104025994`", 
              "0.9736752729101433`", "0.49657889214325357`", 
              "0.03427467976047268`"}}, RowSpacings -> 1, ColumnSpacings -> 
             1, RowAlignments -> Baseline, ColumnAlignments -> Center], 
           "\[NoBreak]", ")"}], Function[BoxForm`e$, MatrixForm[
           BoxForm`e$]]], ",", TagBox[RowBox[{"(", "\[NoBreak]", 
           GridBox[{{"0.24341608427630318`", "0.9650225850803548`", 
              "0.5177698044612455`", "0.037596463714176936`"}, 
             {"0.00007801470622810786`", "0.013465269883626518`", 
              "0.31453188919653`", "0.9943180900515445`"}, 
             {"3.4245678815171725`*^-13", "5.672342648955744`*^-9", 
              "0.000012715404246379946`", "0.003857526536671874`"}}, 
            RowSpacings -> 1, ColumnSpacings -> 1, RowAlignments -> Baseline, 
            ColumnAlignments -> Center], "\[NoBreak]", ")"}], 
         Function[BoxForm`e$, MatrixForm[BoxForm`e$]]], ",", 
        RowBox[{"{", RowBox[{"0.47037805884611067`", ",", 
            "0.19659816027315197`", ",", "0.010151566157586223`"}], "}"}]}], 
      "}"}]], "Output", CellLabel -> "Out[4]="], 
  Cell["2. LinearLayer", "Section"], Cell["LinearLayer[n] computes W.x + b \
with an n\[Times]d weight matrix W and a bias vector b of length n. Normally \
NetInitialize or NetTrain chooses the weights at random. Here we set them by \
hand, so the result can be checked against W.x + b.", "Text"], 
  Cell["W1 = {{0.5, -1., 0.2, 0.}, {0.1, 0.3, -0.4, 0.8}}; b1 = {0.05, \
-0.1};\nlin = LinearLayer[2, \"Weights\" -> W1, \"Biases\" -> b1, \"Input\" \
-> 4]", "Input", CellLabel -> "In[5]:="], 
  Cell[BoxData[InterpretationBox[
     RowBox[{TagBox["LinearLayer", "SummaryHead"], "[", 
       DynamicModuleBox[{Typeset`open$$ = False, Typeset`embedState$$ = 
          "Ready"}, TemplateBox[{PaneSelectorBox[
           {False -> GridBox[{{PaneBox[ButtonBox[DynamicBox[
