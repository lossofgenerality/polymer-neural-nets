            RowAlignments -> Baseline, ColumnAlignments -> Center], 
           "\[NoBreak]", ")"}], Function[BoxForm`e$, MatrixForm[
           BoxForm`e$]]]}], "}"}]], "Output", CellLabel -> "Out[19]="], 
  Cell["9. NetArrayLayer", "Section"], Cell["NetArrayLayer stores an array \
inside the network. It has no input; its output is the array. If the array is \
a learnable parameter, it is trained like a weight. Setting \
LearningRateMultipliers -> 0 freezes it, so it is constant data that training \
cannot change. PolymerNN stores the incidence matrices this way.", "Text"], 
  Cell["The incidence matrix A of the bonds has one row per bead and one \
column per edge. Column p has +1 at the first bead of edge p, -1 at the \
second, and 0 elsewhere.", "Text"], Cell["incidence[n_, pr_] := \
Normal@SparseArray[\n    Flatten[MapIndexed[{{#1[[1]], #2[[1]]} -> 1., \
{#1[[2]], #2[[1]]} -> -1.} &, pr], 1], {n, Length[pr]}];\nAb = incidence[4, \
bonds]; An = incidence[4, pairs];\n{MatrixForm[Ab], MatrixForm[An]}", 
   "Input", CellLabel -> "In[20]:="], 
  Cell[BoxData[RowBox[
     {"{", RowBox[{TagBox[RowBox[{"(", "\[NoBreak]", 
           GridBox[{{"1.`", "0", "0"}, {RowBox[{"-", "1.`"}], "1.`", "0"}, 
             {"0", RowBox[{"-", "1.`"}], "1.`"}, {"0", "0", RowBox[{"-", 
                "1.`"}]}}, RowSpacings -> 1, ColumnSpacings -> 1, 
            RowAlignments -> Baseline, ColumnAlignments -> Center], 
           "\[NoBreak]", ")"}], Function[BoxForm`e$, MatrixForm[
           BoxForm`e$]]], ",", TagBox[RowBox[{"(", "\[NoBreak]", 
           GridBox[{{"1.`", "1.`", "0"}, {"0", "0", "1.`"}, 
             {RowBox[{"-", "1.`"}], "0", "0"}, {"0", RowBox[{"-", "1.`"}], 
              RowBox[{"-", "1.`"}]}}, RowSpacings -> 1, ColumnSpacings -> 1, 
            RowAlignments -> Baseline, ColumnAlignments -> Center], 
           "\[NoBreak]", ")"}], Function[BoxForm`e$, MatrixForm[
           BoxForm`e$]]]}], "}"}]], "Output", CellLabel -> "Out[20]="], 
  Cell["arrB = NetArrayLayer[\"Array\" -> Ab, LearningRateMultipliers -> \
0];\n{arrB[] == Ab, Dimensions[arrB[]]}", "Input", CellLabel -> "In[21]:="], 
  Cell[BoxData[RowBox[{"{", RowBox[{"True", ",", 
        RowBox[{"{", RowBox[{"4", ",", "3"}], "}"}]}], "}"}]], "Output", 
   CellLabel -> "Out[21]="], Cell["10. DotLayer", "Section"], 
  Cell[TextData[{"DotLayer[] is the matrix product of its two inputs. A.m \
adds every edge message to its two beads: +", 
     Cell[BoxData[SubscriptBox["m", "p"]]], " to the first and -", 
     Cell[BoxData[SubscriptBox["m", "p"]]], " to the second, which is \
Newton's third law. The result is the force on each bead, a 4\[Times]3 \
array."}], "Text"], 
  Cell["dot = DotLayer[];\nFB = dot[{Ab, mB}];\n{MatrixForm[FB], \
MatrixForm[Ab.mB]}", "Input", CellLabel -> "In[22]:="], 
  Cell[BoxData[RowBox[
     {"{", RowBox[{TagBox[RowBox[{"(", "\[NoBreak]", 
           GridBox[{{"0.7721020579338074`", "0.`", "0.`"}, 
             {RowBox[{"-", "1.1214148998260498`"}], "0.6831005215644836`", 
              "0.`"}, {RowBox[{"-", "0.21979814767837524`"}], 
              RowBox[{"-", "0.3843172788619995`"}], "0.35569435358047485`"}, 
             {"0.5691109299659729`", RowBox[{"-", "0.29878324270248413`"}], 
              RowBox[{"-", "0.35569435358047485`"}]}}, RowSpacings -> 1, 
            ColumnSpacings -> 1, RowAlignments -> Baseline, 
            ColumnAlignments -> Center], "\[NoBreak]", ")"}], 
         Function[BoxForm`e$, MatrixForm[BoxForm`e$]]], ",", 
        TagBox[RowBox[{"(", "\[NoBreak]", GridBox[{{"0.7721020579338074`", 
              "0.`", "0.`"}, {RowBox[{"-", "1.121414840221405`"}], 
              "0.6831005215644836`", "0.`"}, {RowBox[{"-", 
                "0.21979814767837524`"}], RowBox[{"-", 
                "0.3843172788619995`"}], "0.35569435358047485`"}, 
             {"0.5691109299659729`", RowBox[{"-", "0.29878324270248413`"}], 
              RowBox[{"-", "0.35569435358047485`"}]}}, RowSpacings -> 1, 
            ColumnSpacings -> 1, RowAlignments -> Baseline, 
            ColumnAlignments -> Center], "\[NoBreak]", ")"}], 
         Function[BoxForm`e$, MatrixForm[BoxForm`e$]]]}], "}"}]], "Output", 
   CellLabel -> "Out[22]="], 
  Cell[TextData[{"Every column of A sums to zero, so the forces on the chain \
always add up to zero, whatever phi has learned. (Networks compute in 32-bit \
floats, so zero means about ", Cell[BoxData[SuperscriptBox["10", "-7"]]], 
     ", hence the Chop.)"}], "Text"], 
  Cell["{Total[Ab], Chop[Total[FB], 10^-6]}", "Input", 
   CellLabel -> "In[23]:="], 
  Cell[BoxData[RowBox[
     {"{", RowBox[{RowBox[{"{", RowBox[{"0.`", ",", "0.`", ",", "0.`"}], 
          "}"}], ",", RowBox[{"{", RowBox[{"0", ",", "0", ",", "0"}], 
          "}"}]}], "}"}]], "Output", CellLabel -> "Out[23]="], 
  Cell["11. NetGraph and NetPort: assembling the force network", "Section"], 
  Cell["A NetGraph names its layers and lists the connections. \
NetPort[\"name\"] is an input or output of the whole graph. {a, b} -> c sends \
a to Input1 and b to Input2 of c. This is the bond branch of PolymerNN's \
network for our four-bead chain: inputs bf (3\[Times]4) and bu (3\[Times]3), \
output F (4\[Times]3).", "Text"], Cell["bondNet = NetGraph[<|\n   \"phiB\" -> \
NetMapOperator[phi], \"repB\" -> ReplicateLayer[3, 2], \"mB\" -> \
ThreadingLayer[Times],\n   \"Ab\" -> NetArrayLayer[\"Array\" -> Ab, \
LearningRateMultipliers -> 0], \"sumB\" -> DotLayer[]|>,\n  {NetPort[\"bf\"] \
-> \"phiB\" -> \"repB\", {\"repB\", NetPort[\"bu\"]} -> \"mB\", {\"Ab\", \
\"mB\"} -> \"sumB\" -> NetPort[\"F\"]},\n  \"bf\" -> {3, 4}, \"bu\" -> {3, \
3}]", "Input", CellLabel -> "In[24]:="], 
