            "0.3425730764865875`"}], "}"}]}], "}"}]], "Output", 
   CellLabel -> "Out[14]="], Cell["6. ThreadingLayer", "Section"], 
  Cell["ThreadingLayer[g] combines several arrays entry by entry with g. Its \
inputs are ports Input1, Input2, and so on; given a list {a, b}, the first \
goes to Input1 and the second to Input2. PolymerNN uses it three times with \
Times and once with Plus.", "Text"], 
  Cell[TextData[{"Times, first use (cut): the non-bonded pair force is \
multiplied by the cutoff, so it fades smoothly to zero at ", 
     Cell[BoxData[SubscriptBox["r", "c"]]], "."}], "Text"], 
  Cell["times = ThreadingLayer[Times];\n{times[{fN, nc}], fN nc}", "Input", 
   CellLabel -> "In[15]:="], 
  Cell[BoxData[RowBox[
     {"{", RowBox[{RowBox[{"{", RowBox[{RowBox[{"-", "0.3398495316505432`"}], 
            ",", RowBox[{"-", "0.002735558431595564`"}], ",", 
            "0.003477653255686164`"}], "}"}], ",", 
        RowBox[{"{", RowBox[{RowBox[{"-", "0.33984953365160875`"}], ",", 
            RowBox[{"-", "0.002735558397956266`"}], ",", 
            "0.0034776532497614383`"}], "}"}]}], "}"}]], "Output", 
   CellLabel -> "Out[15]="], Cell["Plus (total): the bond forces and the \
non-bonded forces on each bead are added.", "Text"], 
  Cell["plus = ThreadingLayer[Plus];\na = {{1., 2., 3.}, {4., 5., 6.}}; b = \
{{10., 20., 30.}, {40., 50., 60.}};\n{plus[{a, b}], a + b}", "Input", 
   CellLabel -> "In[16]:="], 
  Cell[BoxData[RowBox[
     {"{", RowBox[{RowBox[{"{", RowBox[{RowBox[{"{", RowBox[{"11.`", ",", 
                "22.`", ",", "33.`"}], "}"}], ",", 
            RowBox[{"{", RowBox[{"44.`", ",", "55.`", ",", "66.`"}], "}"}]}], 
          "}"}], ",", RowBox[{"{", RowBox[
           {RowBox[{"{", RowBox[{"11.`", ",", "22.`", ",", "33.`"}], "}"}], 
            ",", RowBox[{"{", RowBox[{"44.`", ",", "55.`", ",", "66.`"}], 
              "}"}]}], "}"}]}], "}"}]], "Output", CellLabel -> "Out[16]="], 
  Cell["7. ReplicateLayer", "Section"], 
  Cell[TextData[{"A force is a 3-vector, but phi gives a scalar per edge. To \
multiply each scalar by its unit vector u (P\[Times]3), the scalar vector \
(length P) is first copied into a P\[Times]3 array. ReplicateLayer[3, 2] \
inserts a new level 2 of size 3, so row p becomes {", 
     Cell[BoxData[SubscriptBox["f", "p"]]], ", ", 
     Cell[BoxData[SubscriptBox["f", "p"]]], ", ", 
     Cell[BoxData[SubscriptBox["f", "p"]]], "}."}], "Text"], 
  Cell["rep = ReplicateLayer[3, 2];\n{MatrixForm[rep[fB]], \
MatrixForm[Transpose[{fB, fB, fB}]]}", "Input", CellLabel -> "In[17]:="], 
  Cell[BoxData[RowBox[
     {"{", RowBox[{TagBox[RowBox[{"(", "\[NoBreak]", 
           GridBox[{{RowBox[{"-", "0.7721020579338074`"}], RowBox[{"-", 
